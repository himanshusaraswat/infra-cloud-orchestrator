{
  "name": "infra-cloud-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Environment Google Cloud & Firebase WIF Terraform Orchestrator",
  "scripts": {
    "lint": "terraform fmt -check -diff",
    "format": "terraform fmt",
